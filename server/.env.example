PORT=3000
CLIENT_URL=*
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/warcraft
JWT_SECRET=change-this-in-production

# Optional integrations
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Админ dashboard-д нэвтрэх эрхтэй Discord ID-ууд (таслалаар тусгаарлана)
ADMIN_DISCORD_IDS=
# ZeroTier — (a) өөрийн controller (VPS дээрх zerotier-one, үнэгүй, хязгааргүй) — давуу:
ZT_CONTROLLER_URL=            # жишээ: https://139-180-197-166.sslip.io:8443
ZT_CONTROLLER_TOKEN=          # VPS: /var/lib/zerotier-one/authtoken.secret
# (b) эсвэл ZeroTier Central (my.zerotier.com, төхөөрөмж тутамд төлбөртэй):
ZEROTIER_API_TOKEN=
# Серверийн үүсгэсэн глобал сүлжээ (лог дээр хэвлэнэ); тохируулбал шинээр үүсгэхгүй
ZEROTIER_DEFAULT_NETWORK=
# Бот хост (hostbot/bridge.js-ийн BOT_KEY-тэй ижил; олон бот бол BOT_API_KEYS=a,b)
BOT_API_KEY=
# QPay (хэрэглэгчийн өөрийн QPay Админ dashboard)
QPAY_API_BASE=
QPAY_API_KEY=
QPAY_WEBHOOK_SECRET=
# Эзэн (имэйл бүртгэлтэй бол users.id) — ADMIN_DISCORD_IDS-ийн Discord эзэд ч эзэн
OWNER_USER_IDS=
RZR_BOT_URL=
WEBHOOK_SECRET=
